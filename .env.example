# Salin menjadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/crm
DATABASE_URL_TEST=postgres://postgres:PASSWORD@localhost:5432/crm_test
# Rahasia acak panjang (min. 32 karakter) untuk JWT dan cookie
JWT_SECRET=ganti-dengan-string-acak-panjang
COOKIE_SECRET=ganti-dengan-string-acak-panjang-lain
# SMTP kosong = email hanya ditulis ke konsol
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRM <crm@contoh.local>
UPLOAD_MAX_MB=5
# Zona waktu aplikasi (tampilan & input jadwal)
ZONA_WAKTU=Asia/Jakarta
