<%
  // Struktur menu. Item tanpa "anak" = tautan langsung; dengan "anak" = grup yang bisa dibuka-tutup.
  // peran kosong = semua peran.
  const url = new URL(urlSaatIni || '/', 'http://x');
  const filterTugas = url.searchParams.get('filter') || 'terbuka';
  const t = ringkasTugas || { terlambat: 0, hariIni: 0 };
  const MENU = [
    { url: '/', label: 'Dashboard', ikon: 'dashboard' },
    { id: 'tugas', label: 'Tugas & Jadwal', ikon: 'tugas', lencana: t.terlambat, anak: [
      { url: '/tugas', label: 'Semua terbuka', aktif: jalur === '/tugas' && filterTugas === 'terbuka' },
      { url: '/tugas?filter=terlambat', label: 'Terlambat', lencana: t.terlambat, bahaya: true, aktif: jalur === '/tugas' && filterTugas === 'terlambat' },
      { url: '/tugas?filter=hari_ini', label: 'Hari ini', lencana: t.hariIni, aktif: jalur === '/tugas' && filterTugas === 'hari_ini' },
      { url: '/tugas?filter=mendatang', label: 'Mendatang', aktif: jalur === '/tugas' && filterTugas === 'mendatang' },
      { url: '/tugas?filter=selesai', label: 'Selesai', aktif: jalur === '/tugas' && filterTugas === 'selesai' },
    ] },
    { id: 'penjualan', label: 'Penjualan', ikon: 'penjualan', anak: [
      { url: '/pipeline', label: 'Pipeline', ikon: 'pipeline' },
      { url: '/deal', label: 'Daftar deal', ikon: 'deal' },
      { url: '/penawaran', label: 'Penawaran', ikon: 'penawaran' },
    ] },
    { id: 'pelanggan', label: 'Pelanggan', ikon: 'pelanggan', anak: [
      { url: '/leads', label: 'Leads', ikon: 'lead' },
      { url: '/kontak', label: 'Kontak', ikon: 'kontak' },
      { url: '/perusahaan', label: 'Perusahaan', ikon: 'perusahaan' },
    ] },
    { id: 'admin', label: 'Administrasi', ikon: 'admin', peran: ['admin'], anak: [
      { url: '/pengguna', label: 'Pengguna & Tim', ikon: 'pengguna' },
    ] },
  ];
  const cocok = (u) => (u === '/' ? jalur === '/' : jalur === u || jalur.startsWith(`${u}/`));
  MENU.forEach((m) => (m.anak || []).forEach((a) => { if (a.aktif === undefined) a.aktif = cocok(a.url); }));
  const boleh = (m) => !m.peran || m.peran.includes(pengguna.peran);
  const inisial = pengguna.nama.split(/\s+/).slice(0, 2).map((s) => s[0]).join('').toUpperCase();
%>
<nav class="sidebar" id="menu-utama" :class="{ terbuka: menu }" aria-label="Menu utama">
  <div class="merek">
    <span class="logo-merek"><%- include('ikon', { nama: 'merek', ukuran: 18 }) %></span>
    <span>CRM</span>
    <button type="button" class="tombol-ikon tutup-menu" @click="menu = false" aria-label="Tutup menu"><%- include('ikon', { nama: 'tutup', ukuran: 20 }) %></button>
  </div>

  <ul class="daftar-menu">
    <% MENU.filter(boleh).forEach((m) => { %>
      <% if (!m.anak) { const aktif = cocok(m.url); %>
        <li>
          <a href="<%= m.url %>" class="item-menu <%= aktif ? 'aktif' : '' %>" <%- aktif ? 'aria-current="page"' : '' %>>
            <%- include('ikon', { nama: m.ikon }) %><span class="label-menu"><%= m.label %></span>
          </a>
        </li>
      <% } else { const adaAktif = m.anak.some((a) => a.aktif); %>
        <li class="grup-menu <%= adaAktif ? 'berisi-aktif' : '' %>" x-data="grupMenu('<%= m.id %>', <%= adaAktif %>)">
          <button type="button" class="item-menu kepala-grup" @click="ubah()" :aria-expanded="buka.toString()"
            aria-expanded="<%= adaAktif %>" aria-controls="sub-<%= m.id %>">
            <%- include('ikon', { nama: m.ikon }) %>
            <span class="label-menu"><%= m.label %></span>
            <% if (m.lencana) { %><span class="lencana-menu bahaya" x-show="!buka" title="<%= m.lencana %> tugas terlambat"><%= m.lencana %></span><% } %>
            <span class="panah-grup" aria-hidden="true"><%- include('ikon', { nama: 'chevron', ukuran: 16 }) %></span>
          </button>
          <div class="wadah-sub <%= adaAktif ? 'terbuka' : '' %>" :class="{ terbuka: buka }" id="sub-<%= m.id %>">
            <ul class="sub-menu" :inert="!buka">
              <% m.anak.forEach((a) => { %>
                <li>
                  <a href="<%= a.url %>" class="item-sub <%= a.aktif ? 'aktif' : '' %>" <%- a.aktif ? 'aria-current="page"' : '' %>>
                    <% if (a.ikon) { %><%- include('ikon', { nama: a.ikon, ukuran: 16 }) %><% } else { %><span class="titik-sub" aria-hidden="true"></span><% } %>
                    <span class="label-menu"><%= a.label %></span>
                    <% if (a.lencana) { %><span class="lencana-menu <%= a.bahaya ? 'bahaya' : '' %>"><%= a.lencana %></span><% } %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
        </li>
      <% } %>
    <% }) %>
  </ul>

  <div class="profil">
    <span class="avatar" aria-hidden="true"><%= inisial %></span>
    <div class="info-profil">
      <strong><%= pengguna.nama %></strong>
      <small><%= pengguna.peran %></small>
    </div>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="tombol-ikon tombol-keluar" type="submit" aria-label="Keluar dari akun" title="Keluar"><%- include('ikon', { nama: 'keluar' }) %></button>
    </form>
  </div>
</nav>
