<%
  // Menu: [jalur, label, path ikon SVG, peran yang boleh melihat (kosong = semua)]
  const menu = [
    ['/', 'Beranda', 'M3 12l9-9 9 9M5 10v10h14V10', []],
    ['/tugas', 'Tugas & Jadwal', 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11', []],
    ['/pipeline', 'Pipeline', 'M3 3h5v18H3zM10 3h5v12h-5zM17 3h4v8h-4z', []],
    ['/deal', 'Deal', 'M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6', []],
    ['/leads', 'Leads', 'M22 3H2l8 9.46V19l4 2v-8.54L22 3z', []],
    ['/kontak', 'Kontak', 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8', []],
    ['/perusahaan', 'Perusahaan', 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M14 9h1M9 13h1M14 13h1M9 17h1M14 17h1', []],
    ['/pengguna', 'Pengguna & Tim', 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8', ['admin']],
  ];
  const aktif = (j) => j === '/' ? jalur === '/' : jalur.startsWith(j);
%>
<nav class="sidebar" :class="{ terbuka: menu }" aria-label="Menu utama">
  <div class="merek">CRM</div>
  <ul>
    <% menu.filter(m => !m[3].length || m[3].includes(pengguna.peran)).forEach(([j, label, ikon]) => { %>
      <li><a href="<%= j %>" class="<%= aktif(j) ? 'aktif' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="<%= ikon %>"/></svg>
        <%= label %>
      </a></li>
    <% }) %>
  </ul>
  <div class="profil">
    <div><strong><%= pengguna.nama %></strong><br><small class="redup"><%= pengguna.peran %></small></div>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="tombol tombol-kecil" type="submit">Keluar</button>
    </form>
  </div>
</nav>
