<%- include('kepala') %>
<body hx-headers='{"X-CSRF-Token": "<%= csrfToken %>"}'>
<a class="lompat-isi" href="#isi-utama">Lompat ke isi</a>
<div class="kerangka" x-data="{ menu: false }" @keydown.escape="menu = false">
  <%- include('sidebar') %>
  <div class="latar-menu" x-show="menu" x-cloak x-transition.opacity @click="menu = false" aria-hidden="true"></div>
  <main class="isi" id="isi-utama" tabindex="-1">
    <header class="bilah-atas">
      <button class="tombol-ikon menu-hp" type="button" @click="menu = !menu" :aria-expanded="menu.toString()" aria-expanded="false" aria-controls="menu-utama" aria-label="Buka menu">
        <%- include('ikon', { nama: 'menu', ukuran: 22 }) %>
      </button>
      <h1><%= judul %></h1>
    </header>
    <div id="notifikasi" aria-live="polite"></div>
