<%# Satu baris linimasa. Parameter: item, JENIS, tampilKonteks %>
<%
  const ikon = {
    telepon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z',
    rapat: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
    email: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM22 6l-10 7L2 6',
    tugas: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
    catatan: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8',
    tahap: 'M5 12h14M12 5l7 7-7 7',
  };
  const bisaSelesai = item.sumber === 'aktivitas' && (item.jenis === 'tugas' || item.jenis === 'rapat');
  const terlambat = bisaSelesai && !item.selesai_at && item.jadwal_at && new Date(item.jadwal_at) < new Date();
%>
<li class="item-linimasa jenis-<%= item.jenis %> <%= item.selesai_at && bisaSelesai ? 'selesai' : '' %>" id="item-<%= item.sumber %>-<%= item.id %>">
  <span class="ikon-linimasa" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="<%= ikon[item.jenis] %>"/></svg>
  </span>
  <div class="isi-linimasa">
    <div class="baris antara">
      <div>
        <% if (item.sumber === 'tahap') { %>
          <strong><%= item.judul %></strong>: <%= item.dari ? `${item.dari} → ${item.ke}` : `dibuat di ${item.ke}` %>
        <% } else { %>
          <span class="lencana"><%= JENIS[item.jenis] %></span>
          <strong><%= item.judul %></strong>
          <% if (terlambat) { %><span class="lencana lencana-kalah">Terlambat</span><% } %>
        <% } %>
      </div>
      <% if (item.sumber === 'aktivitas') { %>
        <div class="baris">
          <% if (bisaSelesai) { %>
            <button class="tombol tombol-kecil" hx-post="/aktivitas/<%= item.id %>/selesai"
              hx-vals='{"selesai": "<%= item.selesai_at ? '0' : '1' %>", "tampil_konteks": "<%= tampilKonteks ? '1' : '0' %>"}'
              hx-target="closest li" hx-swap="outerHTML">
              <% if (!item.selesai_at) { %><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><% } %>
              <%= item.selesai_at ? 'Buka lagi' : 'Selesai' %></button>
          <% } %>
          <button class="tombol tombol-kecil tombol-bahaya" hx-post="/aktivitas/<%= item.id %>/hapus"
            hx-confirm="Hapus aktivitas ini?" hx-target="closest li" hx-swap="outerHTML" aria-label="Hapus aktivitas">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>
      <% } %>
    </div>
    <% if (item.isi) { %><div class="pra"><%= item.isi %></div><% } %>
    <small class="redup">
      <%= f.tanggalJam(item.waktu) %> · <%= item.sumber === 'tahap' ? item.pembuat || 'Sistem' : item.pemilik %>
      <% if (item.sumber === 'aktivitas' && item.pembuat && item.pembuat !== item.pemilik) { %>(dibuat oleh <%= item.pembuat %>)<% } %>
      <% if (bisaSelesai && item.selesai_at) { %> · selesai <%= f.tanggalJam(item.selesai_at) %><% } %>
      <% if (tampilKonteks) { %>
        <% if (item.deal_id && item.deal) { %> · <a href="/deal/<%= item.deal_id %>"><%= item.deal %></a><% } %>
        <% if (item.kontak_id && item.kontak) { %> · <a href="/kontak/<%= item.kontak_id %>"><%= item.kontak %></a><% } %>
        <% if (item.lead_id && item.lead) { %> · <a href="/leads/<%= item.lead_id %>"><%= item.lead %></a><% } %>
      <% } %>
    </small>
  </div>
</li>
