<%- include('partials/kepala') %>
<body class="halaman-login">
<main class="login-split">
  <%# Kiri: ilustrasi pipeline CRM beranimasi (dekoratif, disembunyikan dari pembaca layar) %>
  <section class="login-visual">
    <div class="merek-login">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
      CRM
    </div>

    <svg class="ilustrasi" viewBox="0 0 520 380" role="presentation" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="gInti" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#38bdf8"/><stop offset="1" stop-color="#0369a1"/></linearGradient>
        <linearGradient id="gBatang" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7dd3fc"/><stop offset="1" stop-color="#0284c7"/></linearGradient>
      </defs>

      <%# Cincin orbit %>
      <circle cx="260" cy="190" r="150" fill="none" stroke="#1e3a5f" stroke-width="1.5"/>
      <circle cx="260" cy="190" r="100" fill="none" stroke="#1e3a5f" stroke-width="1.5"/>

      <%# Garis alur dari kontak ke inti %>
      <g stroke="#38bdf8" stroke-width="2" fill="none" opacity=".6">
        <path class="alur" d="M110 190 L215 190"/>
        <path class="alur" d="M260 40 L260 145"/>
        <path class="alur" d="M410 190 L305 190"/>
        <path class="alur" d="M260 340 L260 235"/>
      </g>

      <%# Kontak yang mengorbit %>
      <g class="orbit">
        <circle class="simpul" cx="110" cy="190" r="14" fill="#0c4a6e" stroke="#38bdf8" stroke-width="2"/>
        <circle class="simpul" cx="260" cy="40" r="14" fill="#0c4a6e" stroke="#38bdf8" stroke-width="2"/>
        <circle class="simpul" cx="410" cy="190" r="14" fill="#0c4a6e" stroke="#38bdf8" stroke-width="2"/>
        <circle class="simpul" cx="260" cy="340" r="14" fill="#0c4a6e" stroke="#38bdf8" stroke-width="2"/>
      </g>
      <g class="orbit-balik" fill="#7dd3fc">
        <circle cx="160" cy="190" r="4"/><circle cx="360" cy="190" r="4"/><circle cx="260" cy="90" r="4"/><circle cx="260" cy="290" r="4"/>
      </g>

      <%# Inti: ikon grafik naik %>
      <g class="inti">
        <circle cx="260" cy="190" r="46" fill="url(#gInti)"/>
        <path d="M238 206 L252 192 L262 200 L282 178" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M272 178 L282 178 L282 188" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      </g>

      <%# Kartu melayang: nilai pipeline %>
      <g class="kartu-melayang">
        <rect x="350" y="250" width="150" height="96" rx="12" fill="#0f2742" stroke="#1e4b74"/>
        <rect x="364" y="264" width="64" height="8" rx="4" fill="#64748b"/>
        <g transform="translate(364 334)">
          <rect class="batang" x="0" y="-36" width="18" height="36" rx="3" fill="url(#gBatang)"/>
          <rect class="batang" x="28" y="-50" width="18" height="50" rx="3" fill="url(#gBatang)"/>
          <rect class="batang" x="56" y="-28" width="18" height="28" rx="3" fill="url(#gBatang)"/>
          <rect class="batang" x="84" y="-56" width="18" height="56" rx="3" fill="url(#gBatang)"/>
        </g>
      </g>
      <%# Kartu melayang: deal menang %>
      <g class="kartu-melayang kedua">
        <rect x="20" y="40" width="150" height="62" rx="12" fill="#0f2742" stroke="#1e4b74"/>
        <circle cx="46" cy="71" r="12" fill="#15803d"/>
        <path d="M40 71 L45 76 L53 66" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="68" y="60" width="84" height="8" rx="4" fill="#cbd5e1"/>
        <rect x="68" y="76" width="56" height="7" rx="3.5" fill="#64748b"/>
      </g>
    </svg>

    <div>
      <h2>Kelola pelanggan dan pipeline penjualan dalam satu tempat.</h2>
      <ul class="poin-login jarak-atas">
        <% ['Leads, kontak, dan deal dengan hak akses per tim', 'Pipeline kanban dan riwayat setiap perubahan', 'Tugas & pengingat follow-up tepat waktu'].forEach(p => { %>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><%= p %></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <%# Kanan: formulir login %>
  <section class="login-panel">
    <form class="form-login" method="post" action="/login" x-data="{ lihat: false, kirim: false }" @submit="kirim = true">
      <h1>Masuk</h1>
      <p class="sub">Silakan masuk dengan akun CRM Anda.</p>
      <% if (galat) { %><div class="notif notif-galat" role="alert"><%= galat %></div><% } %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">Email
        <input id="email" type="email" name="email" value="<%= email %>" required autofocus autocomplete="username" placeholder="nama@perusahaan.co.id">
      </label>
      <label for="password">Password
        <span class="medan-sandi">
          <input id="password" :type="lihat ? 'text' : 'password'" type="password" name="password" required autocomplete="current-password">
          <button type="button" class="tombol-ikon" @click="lihat = !lihat" :aria-label="lihat ? 'Sembunyikan password' : 'Tampilkan password'" aria-label="Tampilkan password">
            <svg x-show="!lihat" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg x-show="lihat" x-cloak width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.9 17.9A10 10 0 0 1 12 20C5 20 1 12 1 12a18 18 0 0 1 5.1-5.9M9.9 4.2A9 9 0 0 1 12 4c7 0 11 8 11 8a18 18 0 0 1-2.2 3.2M1 1l22 22"/><path d="M14.1 14.1a3 3 0 1 1-4.2-4.2"/></svg>
          </button>
        </span>
      </label>
      <button class="tombol tombol-utama" type="submit" :disabled="kirim">
        <span x-text="kirim ? 'Memproses…' : 'Masuk'">Masuk</span>
      </button>
      <p class="catatan-login">Lupa password? Hubungi admin CRM Anda.</p>
    </form>
  </section>
</main>
</body>
</html>
