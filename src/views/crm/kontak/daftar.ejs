<%- include('../../partials/atas') %>
<% if (pesan) { %><div class="notif notif-sukses"><%= pesan %></div><% } %>
<section class="kartu">
  <div class="baris antara">
    <input type="search" name="q" value="<%= q %>" placeholder="Cari nama, email, telepon, perusahaan…" class="lebar-cari"
      hx-get="/kontak" hx-trigger="input changed delay:300ms, search" hx-target="#hasil" hx-push-url="true">
    <a class="tombol tombol-utama" href="/kontak/baru">+ Kontak baru</a>
  </div>
  <div id="hasil"><%- include('tabel') %></div>
</section>
<%- include('../../partials/bawah') %>
