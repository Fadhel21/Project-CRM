<div class="tabel-gulir"><table>
  <thead><tr><th>Judul</th><th>Perusahaan / Kontak</th><th>Tahap</th><th class="angka">Nilai</th><th>Target tutup</th><th>Pemilik</th></tr></thead>
  <tbody>
  <% hasil.baris.forEach(d => { %>
    <tr>
      <td><a href="/deal/<%= d.id %>"><%= d.judul %></a></td>
      <td><%= d.perusahaan || '-' %><% if (d.kontak) { %><br><small class="redup"><%= d.kontak %></small><% } %></td>
      <td><span class="lencana lencana-<%= d.jenis_tahap %>"><%= d.tahap %></span></td>
      <td class="angka"><%= f.rupiah(d.nilai) %></td>
      <td><%= f.tanggal(d.target_tutup) %></td>
      <td><%= d.pemilik %></td>
    </tr>
  <% }) %>
  <% if (!hasil.baris.length) { %><tr><td colspan="6" class="redup">Tidak ada data.</td></tr><% } %>
  </tbody>
  <tfoot><tr><th colspan="3">Total nilai (sesuai filter)</th><th class="angka"><%= f.rupiah(hasil.jumlahNilai) %></th><th colspan="2"></th></tr></tfoot>
</table></div>
<%- include('../../partials/paginasi', { dasar: '/deal',
  ekstra: `&status=${encodeURIComponent(filter.status)}&tahap=${encodeURIComponent(filter.tahap)}&pemilik=${encodeURIComponent(filter.pemilikId)}` }) %>
