<%- include('../../partials/atas') %>
<form class="kartu form-sempit" method="post" action="<%= data.id ? '/leads/' + data.id : '/leads' %>">
  <%- include('../../partials/galat-form') %>
  <%- include('../../partials/peringatan-duplikat') %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Nama <input name="nama" value="<%= data.nama || '' %>" required></label>
  <div class="grid">
    <label>Nama perusahaan <input name="nama_perusahaan" value="<%= data.nama_perusahaan || '' %>"></label>
    <label>Jabatan <input name="jabatan" value="<%= data.jabatan || '' %>"></label>
  </div>
  <div class="grid">
    <label>Email <input type="email" name="email" value="<%= data.email || '' %>"></label>
    <label>Telepon <input name="telepon" value="<%= data.telepon || '' %>"></label>
  </div>
  <div class="grid">
    <label>Sumber
      <select name="sumber_id"><option value="">- Pilih -</option>
        <% sumber.forEach(s => { %><option value="<%= s.id %>" <%= String(data.sumber_id) === String(s.id) ? 'selected' : '' %>><%= s.nama %></option><% }) %>
      </select>
    </label>
    <label>Status
      <select name="status">
        <% Object.entries(STATUS).forEach(([k, v]) => { %><option value="<%= k %>" <%= data.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </label>
  </div>
  <label>Catatan <textarea name="catatan" rows="3"><%= data.catatan || '' %></textarea></label>
  <%- include('../../partials/pilih-pemilik') %>
  <div class="baris">
    <button class="tombol tombol-utama">Simpan</button>
    <a class="tombol" href="<%= data.id ? '/leads/' + data.id : '/leads' %>">Batal</a>
  </div>
</form>
<%- include('../../partials/bawah') %>
